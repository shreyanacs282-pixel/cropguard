# Copy this file to .env and fill in your own values.

# Port the API listens on
PORT=5000

# Where the React app runs (used for CORS)
CLIENT_ORIGIN=http://localhost:5173

# MongoDB connection string.
# LEAVE THIS BLANK to run CropGuard with an in-memory store instead.
# The app works fully without a database - handy for a hackathon demo.
# Local:  mongodb://127.0.0.1:27017/cropguard
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cropguard
MONGODB_URI=

# Which analysis engine to use: "mock" (built in) or "http" (your own model server)
AI_PROVIDER=mock

# Only needed when AI_PROVIDER=http - the URL of your trained model service
MODEL_API_URL=http://localhost:8000/predict
MODEL_API_KEY=
